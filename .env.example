# Copy to .env and fill in (never commit .env)
#
# Normal usage needs ONLY the API key — LLM and embedding models are
# selected automatically per task (see llm/model_selector.py,
# rag/embedding_selector.py). The *_MODEL vars below are optional
# developer overrides.

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT=60

# --- Automatic model selection (default ON) ---
AUTO_SELECT_MODELS=true

# --- Optional developer overrides (advanced; normal users ignore these) ---
# OPENROUTER_MODEL=openai/gpt-4o-mini   # used only when AUTO_SELECT_MODELS=false
# LLM_EFFICIENT_MODEL=openai/gpt-4o-mini
# LLM_GENERAL_MODEL=openai/gpt-4o-mini
# LLM_REASONING_MODEL=openai/gpt-4o-mini
# EMBEDDING_MODEL=openai/text-embedding-3-small
# EMBEDDING_FALLBACK_MODEL=openai/text-embedding-3-small

EMBEDDING_PROVIDER=openrouter
EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=5
MAX_RETRIES=3
MAX_UPLOAD_MB=25
LARGE_DOC_CHARS=60000
